+void
+Terminal::iterm2_1337(vte::parser::Sequence const& seq,
+                      std::string_view const& body) noexcept
+try
+{
+#if VTE_GTK != 4
+        /* Inline images are implemented for the GTK4/GSK backend only; the
+         * GTK3 backend keeps its no-op draw_image and simply ignores them. */
+        (void)seq;
+        (void)body;
+#else
+        // iTerm2 inline image: OSC 1337 ; File=[params]:base64 ST
+        //
+        // See https://iterm2.com/documentation-images.html and WezTerm's
+        // term/src/terminalstate/iterm.rs + wezterm-escape-parser/src/osc.rs
+        // for the reference behaviour implemented here.
+        if (body.substr (0, 5) != "File="sv)
+                return;
+
+        // The parameter list is separated from the base64 payload by the first
+        // ':'; base64 itself never contains one, so this is unambiguous.
+        auto const colon = body.find (':', 5);
+        if (colon == std::string_view::npos)
+                return;
+
+        auto const params = body.substr (5, colon - 5);
+        auto const encoded = body.substr (colon + 1);
+        if (encoded.empty () || encoded.size () > kMaxImageEncodedBytes)
+                return;
+
+        enum class Unit { Automatic, Cells, Pixels, Percent };
+        struct Dimension {
+                Unit unit{Unit::Automatic};
+                long value{0};
+        };
+
+        auto parse_dimension = [](std::string_view const& s) -> Dimension {
+                auto d = Dimension{};
+
+                auto number = s;
+                if (s == "auto"sv) {
+                        return d;
+                } else if (s.size () >= 2 && s.substr (s.size () - 2) == "px"sv) {
+                        d.unit = Unit::Pixels;
+                        number = s.substr (0, s.size () - 2);
+                } else if (s.size () >= 1 && s.back () == '%') {
+                        d.unit = Unit::Percent;
+                        number = s.substr (0, s.size () - 1);
+                } else {
+                        d.unit = Unit::Cells;
+                }
+
+                auto value = 0L;
+                auto const [ptr, ec] = std::from_chars (number.data (),
+                                                        number.data () + number.size (),
+                                                        value);
+                if (ec != std::errc () || ptr != number.data () + number.size ())
+                        return Dimension{};
+
+                d.value = value;
+                return d;
+        };
+
+        auto inline_image = false;
+        auto do_not_move_cursor = false;
+        auto preserve_aspect_ratio = true;
+        auto width_dim = Dimension{};
+        auto height_dim = Dimension{};
+
+        for (auto pos = size_t{0}; pos <= params.size (); ) {
+                auto const semi = params.find (';', pos);
+                auto const token = params.substr (pos, semi == std::string_view::npos ? std::string_view::npos : semi - pos);
+                pos = (semi == std::string_view::npos) ? params.size () + 1 : semi + 1;
+
+                auto const eq = token.find ('=');
+                if (eq == std::string_view::npos)
+                        continue;
