+/* Drop all Kitty graphics image data and placements. */
+void
+Terminal::kitty_clear() noexcept
+{
+        m_kitty_upload.reset();
+        m_kitty_images.clear();
+        m_kitty_images_bytes = 0;
+
+        for (auto *screen_ : {&m_normal_screen, &m_alternate_screen}) {
+                auto& images = screen_->images;
+                images.erase (std::remove_if (images.begin (), images.end (),
+                                              [](auto const& image) {
+                                                      return image->kitty_image_id != 0;
+                                              }),
+                              images.end ());
+        }
+
+        invalidate_all ();
