+/* Drop all inline images of a screen. */
+void
+Terminal::images_clear_screen(VteScreen *screen_) noexcept
+{
+        if (screen_ == nullptr || screen_->images.empty ())
+                return;
+
+        screen_->images.clear ();
+        if (screen_ == m_screen)
+                invalidate_all ();
+}
+
+/* Drop images that can never be visible again: those that have scrolled out
+ * of the ring (their bottom edge is above the first row still retained), and
+ * those whose anchor row was discarded by a rewrap that made the buffer
+ * shorter.  Rings grow on demand, so anchors at or past the current end are
+ * only orphans when the ring has content below them already; the empty or
+ * freshly-initialised case is excluded by requiring end > first. */
+void
+Terminal::images_cull(VteScreen *screen_) noexcept
+{
+        if (screen_ == nullptr || screen_->images.empty ())
+                return;
+
+        auto const first_row = long(screen_->row_data->delta ());
+        auto const end_row = long(screen_->row_data->next ());
+        auto const end = std::remove_if (screen_->images.begin (),
+                                         screen_->images.end (),
+                                         [this, first_row, end_row](auto const& image) {
+                                                 if (image->kitty_image_id != 0 &&
+                                                     m_kitty_images.find (image->kitty_image_id) == m_kitty_images.end ())
+                                                         return true;
+                                                 return image->top + image_cell_rows (*image) - 1 < first_row ||
+                                                        (end_row > first_row && image->top >= end_row);
+                                         });
+        if (end != screen_->images.end ())
+                screen_->images.erase (end, screen_->images.end ());
+}
+
+/* Enforce the per-screen memory budget by evicting the oldest images. */
+void
+Terminal::images_trim_memory(VteScreen *screen_) noexcept
+{
+        if (screen_ == nullptr || screen_->images.empty ())
+                return;
+
+        auto total = gsize{0};
+        for (auto const& image : screen_->images)
+                total += image->bytes;
+
+        auto first = screen_->images.begin ();
+        while (total > kMaxImagesBytes && first != screen_->images.end ()) {
+                total -= (*first)->bytes;
+                ++first;
+        }
+
+        if (first != screen_->images.begin ())
+                screen_->images.erase (screen_->images.begin (), first);
+}
+
+/* Shift the anchors of inline images living inside a scrolling region, when
+ * that region scrolls by moving the cell data in place (i.e. when it does not
+ * push rows into the scrollback).  Images pushed out of the region are
+ * dropped. */
+void
+Terminal::images_scroll_rows(long first_row, long last_row, long delta) noexcept
+{
+        if (delta == 0 || m_screen->images.empty ())
+                return;
+
+        auto const end = std::remove_if (m_screen->images.begin (),
+                                         m_screen->images.end (),
+                                         [this, first_row, last_row, delta](auto const& image) {
+                                                 if (image->top < first_row || image->top > last_row)
+                                                         return false;
+
+                                                 auto const new_top = image->top + delta;
+                                                 auto const rows = image_cell_rows (*image);
+                                                 if (new_top < first_row ||
+                                                     new_top + rows - 1 > last_row)
+                                                         return true;
+
+                                                 image->top = new_top;
+                                                 return false;
+                                         });
+        m_screen->images.erase (end, m_screen->images.end ());
+}
