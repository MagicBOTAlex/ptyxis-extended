+/* Kitty graphics protocol, see https://sw.kovidgoyal.net/kitty/graphics-protocol/
+ *
+ * Implemented subset: query (a=q), direct transmission (a=t, chunked with
+ * m=1, f=100/24/32, o=z), transmit-and-display (a=T, a=f), placement (a=p)
+ * and deletion (a=d).  File-based transports (t=f/t=t) are refused, and
+ * unknown actions are ignored. */
+void
+Terminal::kitty_graphics(vte::parser::Sequence const& seq,
+                         std::string_view const& body) noexcept
+try
+{
+#if VTE_GTK != 4
+        (void)seq;
+        (void)body;
+#else
+        auto const semicolon = body.find (';');
+        auto const control = body.substr (0, semicolon);
+        auto const payload = semicolon == std::string_view::npos
+                ? std::string_view{}
+                : body.substr (semicolon + 1);
+
+        /* Control data is a comma-separated list of key=value pairs. */
+        struct Param {
+                std::string_view key;
+                std::string_view value;
+        };
+        auto params = std::array<Param, 32>{};
+        auto n_params = size_t{0};
+
+        for (auto pos = size_t{0}; pos <= control.size (); ) {
+                auto const comma = control.find (',', pos);
+                auto const token = control.substr (pos, comma == std::string_view::npos
+                                                        ? std::string_view::npos
+                                                        : comma - pos);
+                pos = comma == std::string_view::npos ? control.size () + 1 : comma + 1;
+
+                if (token.empty ())
+                        continue;
+
+                auto const eq = token.find ('=');
+                if (eq == std::string_view::npos || eq == 0)
+                        continue;
+
+                if (n_params < params.size ())
+                        params[n_params++] = {token.substr (0, eq), token.substr (eq + 1)};
+        }
+
+        auto get = [&](std::string_view const& key) -> std::optional<std::string_view> {
+                /* Duplicate keys: the last one wins. */
+                for (auto i = n_params; i-- > 0; )
+                        if (params[i].key == key)
+                                return params[i].value;
+                return std::nullopt;
+        };
+
+        auto get_int = [&](std::string_view const& key, long fallback = 0) -> long {
+                auto const value = get (key);
+                if (!value || value->empty ())
+                        return fallback;
+
+                auto parsed = 0L;
+                auto const [ptr, ec] = std::from_chars (value->data (),
+                                                        value->data () + value->size (),
+                                                        parsed);
+                if (ec != std::errc () || ptr != value->data () + value->size ())
+                        return fallback;
+                return parsed;
+        };
+
+        auto const quiet_level = get_int ("q", 0);
+        auto const quiet_all = quiet_level == 2;   /* no replies at all */
+        auto const quiet_ok = quiet_all || quiet_level == 1; /* errors only */
+        auto const image_id = guint32 (std::max (0L, get_int ("i", 0)));
+        auto const placement_id = guint32 (std::max (0L, get_int ("p", 0)));
+
+        auto reply_with = [&](std::string const& text, bool is_ok) {
+                if (is_ok ? quiet_ok : quiet_all)
+                        return;
+                auto builder = vte::parser::u8SequenceBuilder{VTE_SEQ_APC};
+                builder.set_string ("G" + text);
+                reply (seq, builder);
+        };
+        auto reply_ok = [&](guint32 id) {
+                reply_with (id != 0 ? "i=" + std::to_string (id) + ";OK" : std::string{"OK"}, true);
+        };
+        auto reply_error = [&](guint32 id, char const* code) {
+                reply_with (id != 0 ? "i=" + std::to_string (id) + ";" + code : std::string{code}, false);
+        };
+
+        auto const action = get ("a");
+        auto const action_char = action && !action->empty () ? action->front () : 't';
+
+        /* ---- query ---- */
+        if (action_char == 'q') {
+                reply_ok (image_id);
+                return;
+        }
+
+        /* ---- placement ---- */
+        if (action_char == 'p') {
+                auto const it = m_kitty_images.find (image_id);
+                if (it == m_kitty_images.end ()) {
+                        reply_error (image_id, "ENOENT:no such image");
+                        return;
+                }
+
+                auto const& stored = *it->second;
+                auto const cell_width = int(m_cell_width);
+                auto const cell_height = int(m_cell_height);
+                auto const scale = double(std::max (1, m_draw.scale_factor ()));
+                if (cell_width <= 0 || cell_height <= 0)
+                        return;
+
+                /* Source rectangle, in image pixels. */
+                auto source_x = std::max (0, int(std::min<long> (get_int ("x", 0), INT_MAX)));
+                auto source_y = std::max (0, int(std::min<long> (get_int ("y", 0), INT_MAX)));
+                auto source_w = int(std::min<long> (get_int ("w", 0), INT_MAX));
+                auto source_h = int(std::min<long> (get_int ("h", 0), INT_MAX));
+                if (source_w <= 0)
+                        source_w = stored.width - source_x;
+                if (source_h <= 0)
+                        source_h = stored.height - source_y;
+                source_w = std::min (source_w, stored.width - source_x);
+                source_h = std::min (source_h, stored.height - source_y);
+                if (source_w <= 0 || source_h <= 0)
+                        return;
+
+                /* Target box, in cells.  With neither key the image keeps its
+                 * natural size; with one the other follows the source aspect;
+                 * with both the bitmap is letterboxed inside the box. */
+                auto columns = int(get_int ("c", 0));
+                auto rows = int(get_int ("r", 0));
+                auto draw_w = 0;
+                auto draw_h = 0;
+                auto off_x = 0;
+                auto off_y = 0;
+
+                if (columns <= 0 && rows <= 0) {
+                        /* Natural size: one image pixel per device pixel. */
+                        draw_w = std::max (1, int(std::lround (double(source_w) / scale)));
+                        draw_h = std::max (1, int(std::lround (double(source_h) / scale)));
+                        columns = (draw_w + cell_width - 1) / cell_width;
+                        rows = (draw_h + cell_height - 1) / cell_height;
+                } else if (columns > 0 && rows <= 0) {
+                        auto const box_w = double(columns) * cell_width;
+                        rows = std::max (1, int(std::ceil (box_w * double(source_h) /
+                                                           (double(source_w) * cell_height))));
+                } else if (rows > 0 && columns <= 0) {
+                        auto const box_h = double(rows) * cell_height;
+                        columns = std::max (1, int(std::ceil (box_h * double(source_w) /
+                                                              (double(source_h) * cell_width))));
+                }
+                columns = std::clamp (columns, 1, 4096);
+                rows = std::clamp (rows, 1, 4096);
+
+                auto const box_w = columns * cell_width;
+                auto const box_h = rows * cell_height;
+
+                if (draw_w <= 0) {
+                        auto const s = std::min (double(box_w) / double(source_w),
+                                                 double(box_h) / double(source_h));
+                        draw_w = std::max (1, int(std::lround (double(source_w) * s)));
+                        draw_h = std::max (1, int(std::lround (double(source_h) * s)));
+                        off_x = (box_w - draw_w) / 2;
+                        off_y = (box_h - draw_h) / 2;
+                }
+
+                auto image = std::make_unique<VteImage>();
+                image->top = m_screen->cursor.row;
+                image->left = m_screen->cursor.col;
+                image->width = box_w;
+                image->height = box_h;
+                image->draw_width = draw_w;
+                image->draw_height = draw_h;
+                image->off_x = off_x;
+                image->off_y = off_y;
+                image->src_x = source_x;
+                image->src_y = source_y;
+                image->src_w = source_w;
+                image->src_h = source_h;
+                image->rows = rows;
+                image->columns = columns;
+                image->z = int(std::clamp<long> (get_int ("z", 0), INT_MIN / 2, INT_MAX / 2));
+                image->kitty_image_id = image_id;
+                image->kitty_placement_id = placement_id;
+                image->bytes = 0;
+
+                auto const no_move_cursor = get_int ("C", 0) == 1;
+                auto const insert_row = image->top;
+                auto const insert_col = image->left;
+
+                /* Re-using the same (image, placement) pair replaces the
+                 * previous placement instead of stacking a duplicate. */
+                if (placement_id != 0) {
+                        auto& existing = m_screen->images;
+                        existing.erase (std::remove_if (existing.begin (), existing.end (),
+                                                        [&](auto const& other) {
+                                                                return other->kitty_image_id == image_id &&
+                                                                       other->kitty_placement_id == placement_id;
+                                                        }),
+                                        existing.end ());
+                }
+
+                m_screen->images.push_back (std::move (image));
+
+                if (!no_move_cursor) {
+                        for (auto i = 1; i < rows; i++)
+                                cursor_down_with_scrolling (true);
+                        m_screen->cursor.col = std::min<long> (m_screen->cursor.col + columns,
+                                                               m_column_count - 1);
+                        m_screen->cursor_advanced_by_graphic_character = false;
+                } else {
+                        /* Placements never scroll; keep the cursor put. */
+                        m_screen->cursor.row = insert_row;
+                        m_screen->cursor.col = insert_col;
+                }
+
+                invalidate_all ();
+                reply_ok (image_id);
+                return;
+        }
+
+        /* ---- deletion ---- */
+        if (action_char == 'd') {
+                /* A delete command aborts any partially received image. */
+                m_kitty_upload.reset ();
+
+                auto const what = get ("d");
+                auto const kind = what && !what->empty () ? what->front () : 'a';
+
+                /* Kitty places images on a plane that belongs to the screen;
+                 * deletions apply to the visible screen. */
+                auto should_delete = [&](VteImage const& image) {
+                        switch (kind) {
+                        case 'a':
+                        case 'A':
+                                return true;
+                        case 'i':
+                        case 'I':
+                                return image.kitty_image_id == image_id &&
+                                       (placement_id == 0 || image.kitty_placement_id == placement_id);
+                        default:
+                                /* 'p'/'P' select by cell intersection, which is
+                                 * not implemented; ignore the command. */
+                                return false;
+                        }
+                };
+
+                auto& images = m_screen->images;
+                images.erase (std::remove_if (images.begin (), images.end (),
+                                              [&](auto const& image) {
+                                                      return image->kitty_image_id != 0 &&
+                                                             should_delete (*image);
+                                              }),
+                              images.end ());
+
+                if (kind == 'A') {
+                        m_kitty_images.clear ();
+                        m_kitty_images_bytes = 0;
+                } else if (kind == 'I') {
+                        if (auto const it = m_kitty_images.find (image_id);
+                            it != m_kitty_images.end ()) {
+                                m_kitty_images_bytes -= it->second->bytes;
+                                m_kitty_images.erase (it);
+                        }
+                }
+
+                invalidate_all ();
+                reply_ok (image_id);
+                return;
+        }
+
+        /* ---- transmission ---- */
+        if (action_char != 't' && action_char != 'T' && action_char != 'f' &&
+            !(action == std::nullopt && m_kitty_upload != nullptr))
+                return;
+
+        if (action && (action_char == 't' || action_char == 'T' || action_char == 'f')) {
+                auto const transport = get ("t");
+                if (transport && *transport != "d") {
+                        /* File and temporary-file transports are not supported. */
+                        reply_error (image_id, "ENOTSUP:only direct transmission");
+                        return;
+                }
+
+                auto upload = std::make_unique<KittyUpload> ();
+                upload->id = image_id;
+                upload->format = int(get_int ("f", 32));
+                upload->width = int(std::clamp<long> (get_int ("s", 0), 0, INT_MAX));
+                upload->height = int(std::clamp<long> (get_int ("v", 0), 0, INT_MAX));
+                upload->zlib = get ("o") == std::optional<std::string_view>{"z"};
+                upload->place = action_char != 't';
+                upload->move_cursor = action_char != 'f';
+                m_kitty_upload = std::move (upload);
+        }
+
+        auto *upload = m_kitty_upload.get ();
+        if (upload == nullptr)
+                return;
+
+        auto const more = get_int ("m", 0) != 0;
+
+        /* Each chunk is separately base64 encoded. */
+        if (!payload.empty ()) {
+                auto const encoded = std::string{payload};
+                auto decoded_len = gsize{0};
+                g_autofree guchar *decoded = g_base64_decode (encoded.c_str (), &decoded_len);
+                if (decoded == nullptr || decoded_len == 0) {
+                        auto const id = upload->id;
+                        m_kitty_upload.reset ();
+                        reply_error (id, "EINVAL:invalid base64");
+                        return;
+                }
+                if (upload->data.size () + decoded_len > kMaxKittyEncodedBytes) {
+                        auto const id = upload->id;
+                        m_kitty_upload.reset ();
+                        reply_error (id, "ENOSPC:payload too large");
+                        return;
+                }
+                upload->data.append (reinterpret_cast<char const*> (decoded), decoded_len);
+        }
+
+        if (more)
+                return;
+
+
+        /* Assemble the image. */
+        auto data = std::move (upload->data);
+        auto const id = upload->id;
+        auto const format = upload->format;
+        auto const declared_width = upload->width;
+        auto const declared_height = upload->height;
+        auto const compress = upload->zlib;
+        auto const place = upload->place;
+        auto const move_cursor = upload->move_cursor;
+        m_kitty_upload.reset ();
+
+        if (compress) {
+                g_autoptr(GZlibDecompressor) decompressor = g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB);
+                g_autoptr(GInputStream) memory = g_memory_input_stream_new_from_data (data.data (), data.size (), nullptr);
+                g_autoptr(GInputStream) stream = g_converter_input_stream_new (memory, G_CONVERTER (decompressor));
+                auto out = std::string{};
+                auto buffer = std::array<guint8, 65536>{};
+                for (;;) {
+                        auto const n = g_input_stream_read (stream, buffer.data (), buffer.size (), nullptr, nullptr);
+                        if (n <= 0)
+                                break;
+                        if (out.size () + gsize(n) > kMaxKittyEncodedBytes)
+                                break;
+                        out.append (reinterpret_cast<char const*> (buffer.data ()), gsize(n));
+                }
+                data = std::move (out);
+        }
+
+        if (data.empty ())
+                return;
+
+        g_autoptr(GdkTexture) texture = nullptr;
+        auto width = declared_width;
+        auto height = declared_height;
+
+        if (format == 100) {
+                g_autoptr(GBytes) bytes = g_bytes_new (data.data (), data.size ());
+                g_autoptr(GError) error = nullptr;
+                texture = gdk_texture_new_from_bytes (bytes, &error);
+                if (texture == nullptr)
+                        return;
+                width = int(gdk_texture_get_width (texture));
+                height = int(gdk_texture_get_height (texture));
+        } else if (format == 24 || format == 32) {
+                if (width <= 0 || height <= 0)
+                        return;
+
+                auto const bpp = format == 24 ? 3u : 4u;
+                auto const stride = gsize(width) * bpp;
+                if (gsize(height) * stride > data.size ())
+                        return;
+
+                g_autoptr(GBytes) bytes = g_bytes_new (data.data (), gsize(height) * stride);
+                texture = gdk_memory_texture_new (width, height,
+                                                  format == 24 ? GDK_MEMORY_R8G8B8
+                                                               : GDK_MEMORY_R8G8B8A8,
+                                                  bytes,
+                                                  stride);
+        } else {
+                return;
+        }
+
+        if (texture == nullptr || width <= 0 || height <= 0)
+                return;
+
+        auto const decoded_bytes = gsize(width) * gsize(height) * 4u;
+        if (guint64(width) * guint64(height) > kMaxImagePixels ||
+            decoded_bytes > kMaxImageBytes)
+                return;
+
+        auto const new_id = id != 0 ? id : guint32(++m_kitty_image_seq);
+
+        /* Replacing an image id replaces the data. */
+        if (auto const it = m_kitty_images.find (new_id); it != m_kitty_images.end ()) {
+                m_kitty_images_bytes -= it->second->bytes;
+                m_kitty_images.erase (it);
+        }
+
+        auto stored = std::make_unique<VteKittyImage> ();
+        stored->texture = g_steal_pointer (&texture);
+        stored->width = width;
+        stored->height = height;
+        stored->bytes = decoded_bytes;
+        stored->seq = ++m_kitty_image_seq;
+        m_kitty_images_bytes += decoded_bytes;
+        m_kitty_images[new_id] = std::move (stored);
+
+        /* Bound the store: evict the oldest images (and their placements). */
+        while (!m_kitty_images.empty () &&
+               (m_kitty_images_bytes > kMaxImagesBytes ||
+                m_kitty_images.size () > kMaxKittyImages)) {
+                auto oldest = m_kitty_images.begin ();
+                for (auto it = m_kitty_images.begin (); it != m_kitty_images.end (); ++it)
+                        if (it->second->seq < oldest->second->seq)
+                                oldest = it;
+
+                auto const victim = oldest->first;
+                m_kitty_images_bytes -= oldest->second->bytes;
+                m_kitty_images.erase (oldest);
+
+                for (auto *screen_ : {&m_normal_screen, &m_alternate_screen}) {
+                        auto& images = screen_->images;
+                        images.erase (std::remove_if (images.begin (), images.end (),
+                                                      [victim](auto const& image) {
+                                                              return image->kitty_image_id == victim;
+                                                      }),
+                                      images.end ());
+                }
+        }
+
+        /* a=T / a=f also display the image at the cursor. */
+        if (place) {
+                auto const cell_width = int(m_cell_width);
+                auto const cell_height = int(m_cell_height);
+                auto const scale = double(std::max (1, m_draw.scale_factor ()));
+                if (cell_width > 0 && cell_height > 0) {
+                        auto const natural_w = std::max (1, int(std::lround (double(width) / scale)));
+                        auto const natural_h = std::max (1, int(std::lround (double(height) / scale)));
+                        auto const columns = std::max (1, (natural_w + cell_width - 1) / cell_width);
+                        auto const rows = std::max (1, (natural_h + cell_height - 1) / cell_height);
+
+                        auto image = std::make_unique<VteImage> ();
+                        image->top = m_screen->cursor.row;
+                        image->left = m_screen->cursor.col;
+                        image->width = columns * cell_width;
+                        image->height = rows * cell_height;
+                        image->draw_width = natural_w;
+                        image->draw_height = natural_h;
+                        image->rows = rows;
+                        image->columns = columns;
+                        image->kitty_image_id = new_id;
+                        m_screen->images.push_back (std::move (image));
+
+                        if (move_cursor) {
+                                for (auto i = 1; i < rows; i++)
+                                        cursor_down_with_scrolling (true);
+                                m_screen->cursor.col = std::min<long> (m_screen->cursor.col + columns,
+                                                                       m_column_count - 1);
+                                m_screen->cursor_advanced_by_graphic_character = false;
+                        }
+                }
+        }
+
+        invalidate_all ();
+        reply_ok (new_id);
+#endif /* VTE_GTK == 4 */
+}
+catch (...)
+{
+}
