+                                                 auto const new_top = image->top + delta;
+                                                 auto const rows = image_cell_rows (*image);
+                                                 if (new_top < first_row ||
+                                                     new_top + rows - 1 > last_row)
+                                                         return true;
+
+                                                 image->top = new_top;
+                                                 return false;
+                                         });
+        m_screen->images.erase (end, m_screen->images.end ());
+}
