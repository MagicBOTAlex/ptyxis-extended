+void
+DrawingGsk::draw_image(GdkTexture *texture,
+                       int x,
+                       int y,
+                       int width,
+                       int height) const
+{
+        draw_image_part(texture, 0, 0, 0, 0, x, y, width, height);
+}
+
+void
+DrawingGsk::draw_image_part(GdkTexture *texture,
+                            int source_x,
+                            int source_y,
+                            int source_width,
+                            int source_height,
+                            int x,
+                            int y,
+                            int width,
+                            int height) const
+{
+        g_assert(m_snapshot);
+        if (texture == nullptr || width <= 0 || height <= 0)
+                return;
+
+        auto const texture_width = int(gdk_texture_get_width(texture));
+        auto const texture_height = int(gdk_texture_get_height(texture));
+        if (texture_width <= 0 || texture_height <= 0)
+                return;
+
+        if (source_width <= 0 || source_height <= 0) {
+                source_x = source_y = 0;
+                source_width = texture_width;
+                source_height = texture_height;
+        }
+
+        /* Scale the whole texture so that the source rectangle lands exactly
+         * on the destination rectangle, then clip to the destination so that
+         * nothing outside of it is painted. */
+        auto const scale_x = double(width) / double(source_width);
+        auto const scale_y = double(height) / double(source_height);
+        auto const bounds = vte::graphene::make_rect(
+                int(std::lround (double(x) - double(source_x) * scale_x)),
+                int(std::lround (double(y) - double(source_y) * scale_y)),
+                int(std::lround (double(texture_width) * scale_x)),
+                int(std::lround (double(texture_height) * scale_y)));
+        auto const clip = vte::graphene::make_rect(x, y, width, height);
+
+        gtk_snapshot_push_clip(m_snapshot, &clip);
+        gtk_snapshot_append_scaled_texture(m_snapshot,
+                                           texture,
+                                           GSK_SCALING_FILTER_TRILINEAR,
+                                           &bounds);
+        gtk_snapshot_pop(m_snapshot);
+}
