+/* APC - application program command.
+ *
+ * VTE only dispatches APC for the Kitty graphics protocol, whose payload
+ * starts with 'G'.  Every other APC is ignored, as before this patch. */
+void
+Terminal::APC(vte::parser::Sequence const& seq)
+try
+{
+        auto const str = seq.string ();
+        if (str.empty () || str.front () != U'G')
+                return;
+
+        /* Narrow the payload; base64 and the control data are ASCII. */
+        auto body = std::string{};
+        body.reserve (str.size () - 1);
+        for (auto i = size_t{1}; i < str.size (); i++)
+                body.push_back (str[i] < 0x80 ? char(str[i]) : '\0');
+
+        kitty_graphics (seq, body);
