+void
+Terminal::iterm2_1337(vte::parser::Sequence const& seq,
+                      std::string_view const& body) noexcept
+try
+{
+        // iTerm2 inline image: OSC 1337 ; File=[params]:base64 ST
+        if (body.substr (0, 5) != "File="sv)
+                return;
+
+        auto const colon = body.find (':', 5);
+        if (colon == std::string_view::npos)
+                return;
+
+        auto const params = body.substr (5, colon - 5);
+        auto const encoded = body.substr (colon + 1);
+
+        auto inline_image = false;
+        auto do_not_move_cursor = false;
+
+        for (size_t pos = 0; pos <= params.size (); )
+                {
+                        auto const semi = params.find (';', pos);
+                        auto const token = params.substr (pos, semi == std::string_view::npos ? std::string_view::npos : semi - pos);
+                        pos = (semi == std::string_view::npos) ? params.size () + 1 : semi + 1;
+
+                        if (token.empty ())
+                                continue;
+
+                        auto const eq = token.find ('=');
+                        if (eq == std::string_view::npos)
+                                continue;
+
+                        auto const key = token.substr (0, eq);
+                        auto const value = token.substr (eq + 1);
+
+                        if (key == "inline"sv)
+                                inline_image = (value == "1"sv);
+                        else if (key == "doNotMoveCursor"sv)
+                                do_not_move_cursor = (value == "1"sv);
+                }
+
+        if (!inline_image)
+                return;
+
+        if (m_cell_width <= 0 || m_cell_height <= 0)
+                return;
+
+        auto const encoded_str = std::string{encoded};
+        gsize decoded_len = 0;
+        g_autofree guchar *decoded = g_base64_decode (encoded_str.c_str (), &decoded_len);
+        if (decoded == nullptr || decoded_len == 0)
+                return;
+
+        g_autoptr(GBytes) bytes = g_bytes_new (decoded, decoded_len);
+        g_autoptr(GError) error = nullptr;
+        auto *texture = gdk_texture_new_from_bytes (bytes, &error);
+        if (texture == nullptr)
+                return;
+
+        auto const native_width = gdk_texture_get_width (texture);
+        auto const native_height = gdk_texture_get_height (texture);
+
+        // Fit to the viewport, preserving the aspect ratio.
+        auto const max_width = int (m_column_count) * int (m_cell_width);
+        auto const max_height = int (m_row_count) * int (m_cell_height);
+        auto scale = 1.0;
+        if (native_width > max_width)
+                scale = double (max_width) / native_width;
+        if (native_height > max_height)
+                scale = std::min (scale, double (max_height) / native_height);
+        if (scale > 1.0)
+                scale = 1.0;
+
+        auto const width = std::max (1, int (native_width * scale));
+        auto const height = std::max (1, int (native_height * scale));
+        auto const columns = (width + int (m_cell_width) - 1) / int (m_cell_width);
+
+        auto image = std::make_unique<VteImage>();
+        image->texture = texture; // takes ownership of the reference
+        image->left = m_screen->cursor.col;
+        image->top = m_screen->cursor.row;
+        image->width = width;
+        image->height = height;
+        image->rows = (height + int (m_cell_height) - 1) / int (m_cell_height);
+
+        if (!do_not_move_cursor)
+                {
+                        for (int i = 1; i < image->rows; i++)
+                                cursor_down_with_scrolling (true);
+                        move_cursor_forward (columns);
+                }
+
+        m_screen->images.push_back (std::move (image));
+        invalidate_all ();
+}
