+                else if (key == "doNotMoveCursor"sv)
+                        do_not_move_cursor = (value != "0"sv);
+                else if (key == "preserveAspectRatio"sv)
+                        preserve_aspect_ratio = (value != "0"sv);
+                else if (key == "width"sv)
+                        width_dim = parse_dimension (value);
+                else if (key == "height"sv)
