+{
+        if (delta == 0 || m_screen->images.empty ())
+                return;
+
+        auto const end = std::remove_if (m_screen->images.begin (),
+                                         m_screen->images.end (),
+                                         [this, first_row, last_row, delta](auto const& image) {
+                                                 if (image->top < first_row || image->top > last_row)
