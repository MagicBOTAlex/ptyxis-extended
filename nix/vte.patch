+                auto const key = token.substr (0, eq);
+                auto const value = token.substr (eq + 1);
+
+                // As in WezTerm, the booleans are "true unless explicitly 0",
+                // so that both "inline" and "inline=1" enable the feature.
+                if (key == "inline"sv)
+                        inline_image = (value != "0"sv);
+                else if (key == "doNotMoveCursor"sv)
+                        do_not_move_cursor = (value != "0"sv);
+                else if (key == "preserveAspectRatio"sv)
+                        preserve_aspect_ratio = (value != "0"sv);
+                else if (key == "width"sv)
+                        width_dim = parse_dimension (value);
+                else if (key == "height"sv)
