+                // which we do not support; parsing them is a no-op.
+        }
+
+        // Non-inline requests are file downloads.  We do not implement a
+        // download handler, so ignore them, like WezTerm does without one.
+        if (!inline_image)
+                return;
+
+        auto const cell_width = int(m_cell_width);
+        auto const cell_height = int(m_cell_height);
+        if (cell_width <= 0 || cell_height <= 0)
+                return;
+
+        // Tolerate whitespace and missing padding in the base64 payload, as
+        // iTerm2 does (spec C8).
+        auto encoded_str = std::string{encoded};
+        while (!encoded_str.empty () &&
+               std::isspace (static_cast<unsigned char> (encoded_str.back ())))
+                encoded_str.pop_back ();
+        switch (encoded_str.size () % 4) {
+        case 1:
+                return; /* not a valid base64 length */
+        case 2:
+                encoded_str += "==";
+                break;
+        case 3:
+                encoded_str += '=';
+                break;
+        default:
+                break;
+        }
+
+        auto decoded_len = gsize{0};
+        g_autofree guchar *decoded = g_base64_decode (encoded_str.c_str (), &decoded_len);
+        if (decoded == nullptr || decoded_len == 0)
+                return;
+
+        g_autoptr(GBytes) bytes = g_bytes_new (decoded, decoded_len);
+        g_autoptr(GError) error = nullptr;
+        g_autoptr(GdkTexture) texture = gdk_texture_new_from_bytes (bytes, &error);
+        if (texture == nullptr)
+                return;
+
+        auto const native_width = int(gdk_texture_get_width (texture));
+        auto const native_height = int(gdk_texture_get_height (texture));
+        if (native_width <= 0 || native_height <= 0)
+                return;
+        auto const decoded_bytes = gsize(native_width) * gsize(native_height) * 4u;
+        if (guint64(native_width) * guint64(native_height) > kMaxImagePixels ||
+            decoded_bytes == 0 || decoded_bytes > kMaxImageBytes)
+                return;
+
+        auto const column_count = int(m_column_count);
+        auto const row_count = int(m_row_count);
+        auto const viewport_width = column_count * cell_width;
+        auto const viewport_height = row_count * cell_height;
+
+        // VTE draws in CSS pixels, while images and the "px" unit are in device
+        // pixels (as they are in iTerm2 and WezTerm).  Convert once, so that an
+        // image pixel maps to exactly one device pixel.
+        auto const scale = double(std::max (1, m_draw.scale_factor()));
+
+        auto const round_half_up = [](double v) -> int {
+                return int(std::floor (v + 0.5));
+        };
+
+        auto const clamp_mul = [](long a, long b) -> int {
+                if (a <= 0 || b <= 0)
+                        return 0;
+                if (a > long(INT_MAX) / b)
+                        return INT_MAX;
+                return int(a * b);
+        };
+
+        auto to_pixels = [&](Dimension const& d, int cell_size, int cells) -> std::optional<int> {
+                switch (d.unit) {
+                case Unit::Automatic:
+                        return std::nullopt;
+                case Unit::Cells:
+                        return clamp_mul (d.value, cell_size);
+                case Unit::Pixels:
+                        // "px" is device pixels; VTE draws in CSS pixels.
+                        return d.value <= 0 ? 0 : int(std::lround (double(std::min<long> (d.value, INT_MAX)) / scale));
+                case Unit::Percent:
+                        return round_half_up (double(std::clamp<long> (d.value, 0, 100)) / 100.0 *
+                                              double(cells) * double(cell_size));
+                }
+                return std::nullopt;
+        };
+
+        auto const width_px = to_pixels (width_dim, cell_width, column_count);
+        auto const height_px = to_pixels (height_dim, cell_height, row_count);
+
+        // A requested dimension that resolves to zero drops the image.
+        if ((width_px.has_value () && *width_px <= 0) ||
+            (height_px.has_value () && *height_px <= 0))
+                return;
+
+        auto const native_css_w = std::max (1, round_half_up (double(native_width) / scale));
+        auto const native_css_h = std::max (1, round_half_up (double(native_height) / scale));
+        auto const aspect = double(native_width) / double(native_height);
+
+        // Resolve the requested dimensions per docs/iterm2-inline-images.md §3.2.
+        // "box" is the cell region reserved on the grid, "draw" the bitmap
+        // painted inside it (letterboxed and centred when the aspect ratios
+        // differ).
+        auto box_w = 0, box_h = 0;
+        auto draw_w = 0, draw_h = 0;
+        auto off_x = 0, off_y = 0;
+
+        if (!width_px.has_value () && !height_px.has_value ()) {
+                // Native size, clamped to the viewport preserving aspect.
+                box_w = draw_w = native_css_w;
+                box_h = draw_h = native_css_h;
+                if (viewport_width > 0 && viewport_height > 0 &&
+                    (box_w > viewport_width || box_h > viewport_height)) {
+                        auto const s = std::min (double(viewport_width) / box_w,
+                                                 double(viewport_height) / box_h);
+                        box_w = draw_w = std::max (1, int(std::floor (box_w * s)));
+                        box_h = draw_h = std::max (1, int(std::floor (box_h * s)));
+                }
+        } else if (width_px.has_value () && !height_px.has_value ()) {
+                box_w = draw_w = std::max (1, *width_px);
+                box_h = draw_h = std::max (1, round_half_up (double(box_w) / aspect));
+        } else if (!width_px.has_value () && height_px.has_value ()) {
+                box_h = draw_h = std::max (1, *height_px);
+                box_w = draw_w = std::max (1, round_half_up (double(box_h) * aspect));
+        } else if (preserve_aspect_ratio) {
+                // Reserve the requested box and fit the bitmap inside it.
+                box_w = *width_px;
+                box_h = *height_px;
+                auto const s = std::min (double(box_w) / native_css_w,
+                                         double(box_h) / native_css_h);
+                draw_w = std::max (1, round_half_up (double(native_css_w) * s));
+                draw_h = std::max (1, round_half_up (double(native_css_h) * s));
+                off_x = (box_w - draw_w) / 2;
+                off_y = (box_h - draw_h) / 2;
+        } else {
+                box_w = draw_w = *width_px;
+                box_h = draw_h = *height_px;
+        }
+
+        // Width safety clamp: never paint outside the grid (spec C24).
+        if (viewport_width > 0 && box_w > viewport_width) {
+                auto const s = double(viewport_width) / box_w;
+                box_w = viewport_width;
+                draw_w = std::max (1, int(std::floor (draw_w * s)));
+                box_h = std::max (1, int(std::floor (box_h * s)));
+                draw_h = std::max (1, int(std::floor (draw_h * s)));
+                off_x = (box_w - draw_w) / 2;
+                off_y = (box_h - draw_h) / 2;
+        }
+
+        // iTerm2's structural cap: at most 255 rows of image cells (spec C15).
+        if (auto const max_box_h = 255 * cell_height;
+            max_box_h > 0 && box_h > max_box_h) {
+                auto const s = double(max_box_h) / box_h;
+                box_h = max_box_h;
+                draw_h = std::max (1, int(std::floor (draw_h * s)));
+                box_w = std::max (1, int(std::floor (box_w * s)));
+                draw_w = std::max (1, int(std::floor (draw_w * s)));
+                off_x = (box_w - draw_w) / 2;
+                off_y = (box_h - draw_h) / 2;
+        }
+
+        if (box_w <= 0 || box_h <= 0 || draw_w <= 0 || draw_h <= 0)
+                return;
+
+        // Guard against absurd pixel dimensions, which would make GSK
+        // allocate enormous buffers.
+        static constexpr auto kMaxDimension = 32768;
+        box_w = std::clamp (box_w, 1, kMaxDimension);
+        box_h = std::clamp (box_h, 1, kMaxDimension);
+        draw_w = std::clamp (draw_w, 1, box_w);
+        draw_h = std::clamp (draw_h, 1, box_h);
+
+        auto image = std::make_unique<VteImage>();
+        image->top = m_screen->cursor.row;
+        image->left = m_screen->cursor.col;
+        image->width = box_w;
+        image->height = box_h;
+        image->draw_width = draw_w;
+        image->draw_height = draw_h;
+        image->off_x = off_x;
+        image->off_y = off_y;
+        image->rows = image_cell_rows (*image);
+        image->columns = image_cell_columns (*image);
+        image->bytes = decoded_bytes;
+        image->texture = g_steal_pointer (&texture);
+
+        auto const rows = image->rows;
+        auto const columns = image->columns;
+
+        m_screen->images.push_back (std::move (image));
+        images_trim_memory (m_screen);
+
+        // Cursor semantics (spec C18): the cursor ends on the image's last
+        // row, at the column just right of it, clamped to the last column.
+        // Rows that do not fit scroll the screen (spec C19).
+        if (!do_not_move_cursor) {
+                for (auto i = 1; i < rows; i++)
+                        cursor_down_with_scrolling (true);
+                m_screen->cursor.col = std::min<long> (m_screen->cursor.col + columns,
+                                                       m_column_count - 1);
+                m_screen->cursor_advanced_by_graphic_character = false;
+        }
+
+        invalidate_all ();
+#endif /* VTE_GTK == 4 */
+}
+catch (...)
+{
+}
