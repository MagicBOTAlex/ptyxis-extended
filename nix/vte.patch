+                m_screen->cursor.col = std::min<long> (m_screen->cursor.col + columns,
+                                                       m_column_count - 1);
+                m_screen->cursor_advanced_by_graphic_character = false;
+        }
+
+        invalidate_all ();
+#endif /* VTE_GTK == 4 */
