 void
+Terminal::xterm_set_xselection(vte::parser::Sequence const& seq,
+                               vte::parser::StringTokeniser::const_iterator& token,
+                               vte::parser::StringTokeniser::const_iterator const& endtoken) noexcept
+try
+{
+        // OSC 52 ; Pc ; Pd ST
+        //
+        // Pc selects the target (c = clipboard, p/s = primary) and Pd is the
+        // base64-encoded data. An empty Pc defaults to the clipboard.
+
+        if (token == endtoken)
+                return;
+
+        auto target = vte::platform::ClipboardType::CLIPBOARD;
+        auto const pc = token.string_view();
+        if (!pc.empty()) {
+                switch (pc.front()) {
+                case 'c':
+                        target = vte::platform::ClipboardType::CLIPBOARD;
+                        break;
+                case 'p':
+                case 's':
+                        target = vte::platform::ClipboardType::PRIMARY;
+                        break;
+                default:
+                        // Cut buffers (0-7) and anything else are unsupported.
+                        return;
+                }
+        }
+        ++token;
+
+        if (token == endtoken)
+                return;
+
+        auto const data = token.string();
+        if (data.empty() || data == "?")
+                return;
+
+        gsize len = 0;
+        g_autofree guchar *decoded = g_base64_decode (data.c_str(), &len);
+        if (decoded == nullptr)
+                return;
+
+        set_clipboard_text (target,
+                            std::string_view{reinterpret_cast<char const*>(decoded), len});
+}
+catch (...)
+{
+}
